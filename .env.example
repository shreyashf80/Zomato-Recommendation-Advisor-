# Data
DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
DATA_PATH=./data/processed/restaurants.parquet

# Budget thresholds (tune after exploring dataset)
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Max restaurants passed to LLM after filtering
MAX_CANDIDATES=30

# Optional: store raw HF cache under project
HF_HOME=./data/raw/hf_cache

# LLM (Groq) — https://console.groq.com/
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# LLM_API_KEY=alternative_alias_for_groq_key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_JSON_MODE=true

